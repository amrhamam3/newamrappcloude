<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:background="@color/surface_dark">
        <ImageButton android:id="@+id/btnNestingBack" android:layout_width="44dp" android:layout_height="48dp" android:src="@drawable/ic_nesting_back" android:background="@android:color/transparent" android:tint="@color/accent_orange"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Amr3D Nesting Pro" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="19sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BETA" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="10sp" android:paddingEnd="10dp"/>
        <ImageButton android:id="@+id/btnFullscreen" android:layout_width="44dp" android:layout_height="48dp" android:src="@drawable/ic_bounding_box" android:background="@android:color/transparent" android:tint="@color/accent_orange"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/previewFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.82" android:background="#05070C">
        <com.amr3d.preview.pro.NestingPreviewView android:id="@+id/nestingPreview" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:id="@+id/progressPanel" android:layout_width="330dp" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:padding="18dp" android:gravity="center_horizontal" android:background="#E60A0C11" android:visibility="gone">
            <TextView android:id="@+id/progressStage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="جاري الرص" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
            <TextView android:id="@+id/progressPercent" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:text="0%" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="32sp"/>
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:progressTint="@color/accent_orange"/>
            <Button android:id="@+id/cancelNesting" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="إلغاء" android:textColor="@color/text_primary" android:backgroundTint="@color/warning_red"/>
        </LinearLayout>
        <TextView android:id="@+id/previewHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="مرّر على البنود بالترتيب ثم راجع المعاينة قبل تنفيذ الرص" android:textColor="@color/text_secondary" android:textSize="12sp" android:padding="10dp"/>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.18" android:fillViewport="true">
      <LinearLayout android:id="@+id/stepsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/step01Header" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="01  نوع الإدخال" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step01Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مصدر الرص" android:textColor="@color/accent_orange" android:textStyle="bold"/>
          <Spinner android:id="@+id/inputTypeSpinner" android:layout_width="match_parent" android:layout_height="44dp"/>
          <TextView android:id="@+id/sourceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لم يتم التحديد" android:textColor="@color/text_secondary" android:paddingTop="8dp"/>
          <Button android:id="@+id/chooseFileButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="اختيار ملف DXF" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
          <Button android:id="@+id/step01Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="التالي  →" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step02Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="02  مقاس اللوح" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step02Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مقاس اللوح" android:textColor="@color/accent_orange" android:textStyle="bold"/>
          <Spinner android:id="@+id/boardPreset" android:layout_width="match_parent" android:layout_height="44dp"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/boardWidth" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:inputType="numberDecimal" android:text="1220" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="الطول mm"/>
            <EditText android:id="@+id/boardHeight" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="5dp" android:inputType="numberDecimal" android:text="2440" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="العرض mm"/>
          </LinearLayout>
          <Button android:id="@+id/step02Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="التالي  →" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step03Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="03  الخزائن / الوحدات المخصصة" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step03Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <LinearLayout android:id="@+id/unitsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
          <Button android:id="@+id/addUnitButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="＋ إضافة وحدة أخرى" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
          <Button android:id="@+id/step03Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="التالي  →" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step04Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="04  ماكينة + هامش الرص" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step04Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <Spinner android:id="@+id/machineType" android:layout_width="match_parent" android:layout_height="44dp"/>
          <EditText android:id="@+id/toolDiameter" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="numberDecimal" android:text="6" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="قطر أداة CNC mm"/>
          <EditText android:id="@+id/partGap" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:inputType="numberDecimal" android:text="6" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="المسافة بين القطع mm"/>
          <EditText android:id="@+id/edgeMargin" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:inputType="numberDecimal" android:text="6" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="هامش الحواف الموحد mm"/>
          <Button android:id="@+id/step04Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="التالي  →" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step05Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="05  اتجاه وطريقة الرص" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step05Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <Spinner android:id="@+id/nestingStrategy" android:layout_width="match_parent" android:layout_height="44dp"/>
          <EditText android:id="@+id/dxfCopies" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:inputType="number" android:text="10" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="عدد نسخ DXF"/>
          <Spinner android:id="@+id/grainDirection" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"/>
          <EditText android:id="@+id/rotationStep" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:inputType="numberDecimal" android:text="15" android:textColor="@color/text_primary" android:background="@drawable/bg_nesting_input" android:hint="خطوة الدوران درجة"/>
          <Button android:id="@+id/step05Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="التالي  →" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step06Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="06  مراجعة نهائية" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step06Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <TextView android:id="@+id/reviewText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="13sp"/>
          <Button android:id="@+id/step06Next" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="تأكيد الإعدادات" android:textColor="#111111" android:backgroundTint="@color/accent_orange"/>
        </LinearLayout>

        <TextView android:id="@+id/step07Header" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="07  تنفيذ الرص" android:textColor="@color/accent_orange" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_nesting_section" android:paddingStart="14dp"/>
        <LinearLayout android:id="@+id/step07Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_nesting_section">
          <Button android:id="@+id/startNesting" android:layout_width="match_parent" android:layout_height="50dp" android:text="ابدأ NESTING" android:textColor="#111111" android:textStyle="bold" android:backgroundTint="@color/accent_orange"/>
          <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لم يتم تنفيذ الرص بعد" android:textColor="@color/text_secondary" android:paddingTop="8dp"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnBoardColor" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/nesting_board_color" android:textSize="12sp" android:textColor="@color/text_primary" android:backgroundTint="@color/surface_dark"/>
            <Button android:id="@+id/btnExportDxf" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="@string/nesting_export_dxf" android:textSize="12sp" android:textColor="#111111" android:backgroundTint="@color/accent_orange" android:enabled="false"/>
            <Button android:id="@+id/btnExportPdf" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/nesting_export_pdf" android:textSize="12sp" android:textColor="#111111" android:backgroundTint="@color/accent_orange" android:enabled="false"/>
          </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="24dp"/>
      </LinearLayout>
    </ScrollView>
</LinearLayout>
